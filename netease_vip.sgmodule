#!name=网易云VIP换头
#!desc=用户专属VIP Cookie换头 (2026-10-18更新: 覆盖会员认证接口)

[MITM]
hostname = music.163.com, *.music.163.com

[Script]
网易云VIP换头_播放 = type=http-request,pattern=player/url,script-path=https://raw.githubusercontent.com/XianYu8888/actions-sandbox/main/netease_vip.js,requires-body=false
网易云VIP换头_认证 = type=http-request,pattern=vipauth|vip/info|nuser/account,script-path=https://raw.githubusercontent.com/XianYu8888/actions-sandbox/main/netease_vip.js,requires-body=false
